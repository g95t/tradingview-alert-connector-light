{
    "include": ["src/**/*"],
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "rootDir": "./src",
        "outDir": "./dist",
        "sourceMap": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": false,
        "strictPropertyInitialization": false,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "lib": ["es2022", "webworker"]
    }
}
