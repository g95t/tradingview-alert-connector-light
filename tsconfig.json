{
    "include": ["src/**/*"],
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "rootDir": "./src",
        "outDir": "./dist",
        "sourceMap": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": false,
        "strictPropertyInitialization": false,
        "resolveJsonModule": true,
        "skipLibCheck": true
    }
}
